# Text is stored as LF and converted back on checkout, so a clean clone behaves
# the same on Windows and Linux whatever `core.autocrlf` the cloner has set.
# Only files whose endings actually do something pin `eol=`; the rest are
# checked out with the platform's native ending.

# The default for anything Git detects as text.
* text=auto

# Declared text, not sniffed. `diff=` picks a built-in function-context driver,
# so a hunk header names the enclosing member instead of a stray brace.
*.cs            text diff=csharp
*.md            text diff=markdown
*.csproj        text
*.props         text
*.targets       text
*.slnx          text
*.json          text
*.yml           text
*.yaml          text
*.xml           text
*.config        text
*.ps1           text
*.psm1          text
*.psd1          text
.gitattributes  text
.gitignore      text
.editorconfig   text

# Endings that break things if they change: a POSIX shell chokes on a trailing
# CR, cmd.exe mis-parses an LF-only batch file, and Visual Studio still wants
# CRLF in .sln.
*.sh            text eol=lf
*.bash          text eol=lf
*.cmd           text eol=crlf
*.bat           text eol=crlf
*.sln           text eol=crlf

# Byte-exact. A patch stops applying once its endings are rewritten, and a
# signing key is not text.
*.patch         -text
*.diff          -text
*.snk           binary
*.pfx           binary

# Binary: the macro for -text -diff -merge.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.7z            binary
*.dll           binary
*.exe           binary
*.pdb           binary
*.nupkg         binary
*.snupkg        binary
*.ttf           binary
*.woff          binary
*.woff2         binary
