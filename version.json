{
  "$schema": "https://raw.githubusercontent.com/dotnet/Nerdbank.GitVersioning/main/src/NerdBank.GitVersioning/version.schema.json",

  // The one file to bump, and only for a new major/minor. Nerdbank.GitVersioning derives the
  // patch from git height (commits since this line last changed), so an ordinary commit needs no
  // version edit and two commits can never claim the same version.
  "version": "0.3",

  // Git height starts at 1 on the commit that introduces a version, which would make the first
  // release 0.1.1. Offsetting by -1 starts the patch at 0, so a new major/minor ships as x.y.0.
  "versionHeightOffset": -1,

  // Which refs get a clean version: on main, 0.3.0. Anywhere else, 0.3.0-g5f480c1095, a
  // prerelease by construction, so a package built off a branch can never be mistaken for a
  // release. This decides suffixes only. There are no release branches and no
  // `nbgv prepare-release` flow here.
  //
  // The key is "publicReleaseRefSpec". "publicReleaseRefs" is what most examples show and what
  // the documentation calls the feature, but nbgv 3.10 deserializes the C# property name. An
  // entry under the other spelling is silently ignored and every build looks like a prerelease.
  "publicReleaseRefSpec": [
    "^refs/heads/main$"
  ]

  // No pathFilters: both servers ship one shared version, so a commit touching either one (or
  // neither) advances both. Splitting them means two version.json files and two release flows,
  // which is a bigger decision than a build setting.
}
