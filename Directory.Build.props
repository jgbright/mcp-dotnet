<Project>

  <!--
    NuGet metadata shared by every project here, so it cannot drift between csproj files. The
    test projects inherit it too and opt out of packing with IsPackable=false.

    Not set here, on purpose:
      Version                      Nerdbank.GitVersioning sets it from version.json (below)
      PackageId / ToolCommandName  per project; they make each package a distinct tool
  -->
  <PropertyGroup>
    <Authors>Jason Bright</Authors>
    <Product>mcp-dotnet</Product>
    <PackageTags>mcp;model-context-protocol;stdio;ai</PackageTags>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>

    <PackageProjectUrl>https://github.com/jgbright/mcp-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jgbright/mcp-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- An SPDX expression, not PackageLicenseFile: nuget.org links the license text it already
         has, so the package carries no copy. LICENSE at the repository root is the same license
         for anyone reading the source. -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <!--
    Nerdbank.GitVersioning reads version.json, adds the git height as the patch, and injects
    Version / AssemblyVersion / FileVersion / PackageVersion for every project here. Hence no
    <Version> above: an explicit one conflicts with what it sets.

    PrivateAssets="all" keeps it build-time only, out of both packages' dependency lists.

    It needs real git history. A shallow clone (CI's default) produces a wrong version or a build
    failure, so both workflows check out with fetch-depth: 0.
  -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.91" PrivateAssets="all" />
  </ItemGroup>

</Project>
